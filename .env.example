#################################################
# UPLOAD AUTHENTICATION
#################################################

# Purpose:
# These credentials protect the upload endpoints of the Wanderer application.
# They are NOT Docker credentials and NOT database credentials.
# They are used by the application to restrict who can upload files
# (e.g. GPX tracks, images, or other user-generated content).

# UPLOAD_USER=wanderer_uploader

# Generate secure password with:
# openssl rand -hex 16

# UPLOAD_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD


